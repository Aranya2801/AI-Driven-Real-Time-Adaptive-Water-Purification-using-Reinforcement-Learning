# =============================================================================
# AquaPurify-RL Environment Configuration
# Copy this to .env and fill in your values
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────
APP_NAME=AquaPurify-RL
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-in-production

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aquapurify
POSTGRES_USER=aquauser
POSTGRES_PASSWORD=aquapassword123

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=aquapurify
INFLUXDB_BUCKET=water_quality

MONGODB_URI=mongodb://localhost:27017/aquapurify

# ── IoT / MQTT ─────────────────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=iotuser
MQTT_PASSWORD=iotpassword
MQTT_TOPIC_PREFIX=aquapurify/sensors

# ── Kafka ──────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_SENSOR_DATA=water-sensor-data
KAFKA_TOPIC_RL_ACTIONS=rl-actions
KAFKA_CONSUMER_GROUP=aquapurify-consumers

# ── AWS ───────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=aquapurify-models
AWS_IOT_ENDPOINT=your-iot-endpoint.iot.us-east-1.amazonaws.com

# ── Azure ─────────────────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=your-azure-connection-string
AZURE_IOT_HUB_CONNECTION_STRING=your-iothub-connection-string

# ── GCP ───────────────────────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=path/to/gcp-credentials.json
GCP_PROJECT_ID=aquapurify-project
GCP_BUCKET=aquapurify-gcp-models

# ── MLOps ─────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=aquapurify-rl
WANDB_API_KEY=your-wandb-api-key
WANDB_PROJECT=aquapurify-rl
WANDB_ENTITY=your-wandb-entity
DVC_REMOTE=s3://aquapurify-models/dvc

# ── LLM / AI ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key
HUGGINGFACE_TOKEN=your-hf-token
LLM_MODEL=gpt-4
LOCAL_LLM_HOST=http://localhost:11434

# ── RL Training ───────────────────────────────────────────────────────────
RL_ALGORITHM=PPO
RL_TOTAL_TIMESTEPS=1000000
RL_LEARNING_RATE=0.0003
RL_BATCH_SIZE=64
RL_N_STEPS=2048
RL_GAMMA=0.99
RL_GAE_LAMBDA=0.95
RL_DEVICE=cuda

# ── Water Quality Thresholds (WHO Standards) ──────────────────────────────
PH_MIN=6.5
PH_MAX=8.5
TURBIDITY_MAX=4.0
TDS_MAX=500
DISSOLVED_OXYGEN_MIN=6.0
CHLORINE_MIN=0.2
CHLORINE_MAX=4.0
NITRATE_MAX=10.0
TEMPERATURE_MAX=25.0

# ── Monitoring ────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin123
ALERTMANAGER_PORT=9093

# ── API Server ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
JWT_EXPIRE_MINUTES=1440

# ── Dashboard ─────────────────────────────────────────────────────────────
STREAMLIT_PORT=8501
DASHBOARD_REFRESH_INTERVAL=5
